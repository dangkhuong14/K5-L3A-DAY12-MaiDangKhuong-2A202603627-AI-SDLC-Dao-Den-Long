{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite game --host 0.0.0.0",
    "build": "vite build game --outDir ../dist --emptyOutDir --base ./",
    "headless": "tsx game/src/headless.ts",
    "test": "tsx --test game/tests/*.test.ts",
    "evidence": "node scripts/evidence.mjs",
    "evidence:phase2": "node scripts/evidence-phase2.mjs",
    "evidence:phase3": "node scripts/evidence-phase3.mjs",
    "start": "npm run --silent build && electron .",
    "bench": "npm run --silent build && electron . --bench",
    "soak": "node --expose-gc --max-semi-space-size=1 --import tsx game/src/soak.ts",
    "evidence:phase4": "node scripts/evidence-phase4.mjs",
    "serve": "node scripts/serve-dist.mjs dist 8080"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "electron": "^37.10.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "main": "electron/main.cjs"
}
